<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="expo.modules.slackboardwear" >

    <uses-sdk android:minSdkVersion="24" />

    <application>

        <!-- The system starts this when the watch sends a message, even with the app closed. -->
        <service
            android:name="expo.modules.slackboardwear.WatchListener"
            android:exported="true" >
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />

                <data
                    android:host="*"
                    android:pathPrefix="/slackboard"
                    android:scheme="wear" />
            </intent-filter>
        </service>
    </application>

</manifest>