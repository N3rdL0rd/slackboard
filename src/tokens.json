      "middle": { "color": "#4C8DFF", "shape": "circle" },
      "finish": { "color": "#FF5A52", "shape": "triangle" },
      "foot": { "color": "#E357D9", "shape": "diamond" },
      "highContrast": "#EDEBE4"
    },
    "gradeBand": [
      { "name": "pink", "from": "VB", "to": "V0", "fill": "#F49AC2", "text": "#101416", "border": "#F49AC2", "textContrast": 9.0 },
      { "name": "blue", "from": "V1", "to": "V2", "fill": "#5AA9FF", "text": "#101416", "border": "#5AA9FF", "textContrast": 7.5 },
      { "name": "green", "from": "V3", "to": "V4", "fill": "#4FD08A", "text": "#101416", "border": "#4FD08A", "textContrast": 9.5 },
      { "name": "white", "from": "V5", "to": "V6", "fill": "#F2F0EA", "text": "#101416", "border": "#F2F0EA", "textContrast": 16.3 },
      { "name": "red", "from": "V7", "to": "V8", "fill": "#F2554D", "text": "#101416", "border": "#F2554D", "textContrast": 5.5 },
      { "name": "black", "from": "V9", "to": "V10", "fill": "#050607", "text": "#EDEBE4", "border": "#EDEBE4", "borderWidth": 1.5, "textContrast": 17.0 },
      { "name": "violet", "from": "V11", "to": "V12", "fill": "#050607", "text": "#9A6BFF", "border": "#9A6BFF", "borderWidth": 1.5, "textContrast": 5.7 },
      { "name": "amber", "from": "V13", "to": "V14", "fill": "#050607", "text": "#FFB020", "border": "#FFB020", "borderWidth": 1.5, "textContrast": 11.1 },
      { "name": "lime", "from": "V15", "to": null, "fill": "#050607", "text": "#C4E04A", "border": "#C4E04A", "borderWidth": 1.5, "textContrast": 13.6 }
    ],
    "ledStatus": { "disconnected": "#6C7674" }
  },
  "typography": {
    "family": {
      "display": "Barlow Condensed",
      "ui": "Barlow",
      "wordmark": "Caveat Brush"
    },
    "scale": {
      "screenTitle": { "family": "display", "weight": 700, "size": 36 },
      "sheetTitle": { "family": "display", "weight": 700, "size": 28 },
      "climbNameList": { "family": "display", "weight": 600, "size": 22 },
      "climbNameView": { "family": "display", "weight": 700, "size": 32 },
      "gradeChipList": { "family": "display", "weight": 700, "size": 26 },
      "gradeChipView": { "family": "display", "weight": 700, "size": 44 },
      "button": { "family": "display", "weight": 700, "size": 22, "letterSpacing": 0.8, "uppercase": true },
      "body": { "family": "ui", "weight": 400, "size": 16 },
      "bodyStrong": { "family": "ui", "weight": 600, "size": 16.5 },
      "secondary": { "family": "ui", "weight": 400, "size": 14 },
      "sectionLabel": { "family": "ui", "weight": 600, "size": 13, "letterSpacing": 0.8, "uppercase": true },
      "navLabel": { "family": "ui", "weight": 500, "size": 12 }
    }
  },
  "radius": { "thumb": 10, "chipRect": 9, "input": 12, "card": 16, "board": 14, "sheetTop": 24, "pill": 999 },
  "size": {
    "touchMin": 44,
    "button": { "small": 48, "default": 54, "large": 56 },
    "chip": 36,
    "toggleChip": 44,
    "topBar": 56,
    "bottomNav": 76,
    "bottomActionBar": 84,
    "listThumb": 64,
    "screenPaddingX": 16
  },
  "layout": { "viewport": { "width": 390, "height": 844 }, "boardGridPlaceholder": "12x12" },
  "rules": {
    "minTextContrast": 4.5,
    "minLargeTextContrast": 3,
    "noEmoji": true,
    "colorNeverOnlyCue": true
  }
}
