{
  "name": "Slackboard",
  "version": "0.1.0",
  "color": {
    "surface": { "ground": "#121618", "card": "#1A2023", "raised": "#232A2E", "board": "#0C0F10", "boardArt": "#343436", "scrim": "rgba(5,8,9,0.62)" },
    "line": { "default": "#2F383D", "strong": "#3A454A", "divider": "#1E2528", "dim": "#46515A" },
    "text": { "primary": "#EDEBE4", "secondary": "#C5CBC9", "muted": "#A3ABA9", "caption": "#9BA4A2", "placeholder": "#8F9896" },
    "action": {
      "primaryFill": "#EDEBE4", "primaryText": "#121618",
      "disabledFill": "#2F383D", "disabledText": "#A3ABA9",
      "danger": "#FF8A82", "dangerText": "#121618"
    },
    "rating": { "starOn": "#E8C766", "starOff": "#46515A", "classicBorder": "#6B5D2E", "classicText": "#E8C766" },
    "holdRole": {
