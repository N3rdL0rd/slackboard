{
  "name": "slackboard",
  "version": "0.1.0",
  "description": "An open-source climbing logbook and board companion for Tension, Decoy, Grasshopper and MoonBoard.",
  "license": "MIT",
  "keywords": [
    "climbing",
    "bouldering",
    "training-board",
    "react-native",
    "expo"
  ],
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prebuild:android": "expo prebuild --platform android --no-install",
    "prebuild:ios": "expo prebuild --platform ios",
    "build:android": "bash scripts/build-android.sh"
  },
  "dependencies": {
    "@expo-google-fonts/barlow": "^0.4.1",
    "@expo-google-fonts/barlow-condensed": "^0.4.1",
    "@expo-google-fonts/caveat-brush": "^0.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "expo": "~58.0.22",
    "expo-background-task": "~58.0.12",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.14",
    "expo-dev-client": "~58.0.18",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.8",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-keep-awake": "~58.0.3",
    "expo-linking": "~58.0.15",
    "expo-location": "~58.0.20",
    "expo-media-library": "~58.0.14",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.29",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.21",
    "expo-splash-screen": "~58.0.12",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-task-manager": "~58.0.13",
    "react": "^19.3.0",
    "react-dom": "19.3.0",
    "react-native": "^0.88.1",
    "react-native-ble-plx": "^3.5.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-view-shot": "6.1.1",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
